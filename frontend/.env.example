# InternFlow frontend environment variables (placeholder template).
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed (NFR-SEC-008).
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never place secrets in a NEXT_PUBLIC_ variable.

# Base URL of the InternFlow backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
