<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.internflow</groupId>
    <artifactId>internflow-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>InternFlow Backend</name>
    <description>Backend foundation for the InternFlow internship operations platform (modular monolith)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Included per the confirmed stack (IF-DEC-04). Stage 2.3 added the
             session-based authentication foundation (com.internflow.auth): a
             deny-by-default filter chain, BCrypt, CSRF protection, server-managed
             sessions, and provisional sign-in/sign-out endpoints. Persisted
             accounts, an approved API contract, and end-to-end login do NOT exist
             yet (OD-02/OD-03 block the first migration), so this is a foundation,
             not a complete login system. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Server-side request validation for the API boundary (SRS-IF-03; SAD §6
             mandates bean validation for input shape). Required for the authentication
             request DTOs; later modules reuse it for their DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Included per the confirmed stack (IF-DEC-06). No entities or migrations exist yet;
             the database design (DDD.md) is still a draft. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
